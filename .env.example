# Copy this file to .env and edit the values.

# Where your videos live. This becomes /shows inside the container.
#   Windows : MEDIA_PATH=G:/Youtube/shows
#   Linux   : MEDIA_PATH=/mnt/media/youtube
#   macOS   : MEDIA_PATH=/Volumes/media/youtube
MEDIA_PATH=

# Where SlugTube keeps its config, cookies, archive, logs and database.
# Keep this SEPARATE from your media. It is small but must not be lost.
#   Windows : CONFIG_PATH=C:/SlugTube
#   Linux   : CONFIG_PATH=/opt/slugtube/config
CONFIG_PATH=

# Web UI port on the host
WEB_PORT=5000

# Your timezone, so scheduled runs happen when you expect
TZ=UTC

# Schedules (cron format). Fast check looks at recent videos only.
FAST_CRON=0 */6 * * *
FULL_CRON=0 3 * * 0
UPDATE_CRON=0 1 * * *

# File ownership for downloaded files (Linux/NAS). Leave as-is on Windows.
PUID=1000
PGID=1000
