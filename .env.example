# ============================================================
# SlugTube Configuration
# ============================================================
# Copy this file to .env and edit the values below.
# At minimum, set SHOWS_DIR and CONFIG_DIR to your paths.
# ============================================================

# Where videos are stored — mount your media drive here
# Examples:
#   Linux:   /mnt/media/youtube
#   macOS:   /Volumes/Media/youtube
#   Windows: //host.docker.internal/G$/Youtube/shows
SHOWS_DIR=/path/to/your/media/shows

# SlugTube config directory (database, logs, cookies, archive)
# Examples:
#   Linux:   /opt/slugtube/config
#   macOS:   ~/slugtube
#   Windows: //host.docker.internal/C$/SlugTube
CONFIG_DIR=/path/to/your/config

# Web UI port
WEB_PORT=5000

# Timezone (used for cron schedules and log timestamps)
TZ=UTC

# Download schedules (cron expressions)
FAST_CRON=0 */6 * * *
FULL_CRON=0 3 * * 0
UPDATE_CRON=0 1 * * *

# File ownership (match your host user's UID/GID)
PUID=1000
PGID=1000
